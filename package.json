{
  "name": "makasna-broadcast-cg",
  "version": "1.0.0",
  "description": "Standalone Broadcast Character Generator (CG) Desktop Engine for Windows",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "dev": "cross-env NODE_ENV=development concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [
    "broadcast",
    "character-generator",
    "cg",
    "graphics",
    "lower-third",
    "ndi",
    "vmix",
    "obs"
  ],
  "author": "Makasna <admin@justrangga.space>",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.12.2",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
